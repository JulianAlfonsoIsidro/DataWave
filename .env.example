# Copy this file to `.env` in the repository root and fill in your own values.
#   macOS/Linux:  cp .env.example .env
#   PowerShell:   Copy-Item .env.example .env
# `.env` is git-ignored. Never commit real credentials.
#
# If any is missing or empty, every AI feature 
# runs in Demo Mode (built-in rules).

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# AWS Region where you have Bedrock model access, e.g. ap-southeast-1
AWS_REGION=
# A Bedrock model ID or inference profile ID/ARN that supports the Converse API.
# Many newer models need an inference profile ID (for example one that starts
# with "us." or "global."), not the bare model ID. Check the Bedrock console.
BEDROCK_MODEL_ID=

