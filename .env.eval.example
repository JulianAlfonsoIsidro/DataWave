# Copy to `.env.eval` (git-ignored). Used only by evaluation/run_benchmark.py.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
# Bedrock model or inference profile ID that supports the Converse API.
BEDROCK_MODEL_ID=
# Verified prices per 1,000,000 tokens (your own verified figures; none are assumed by the script).
BEDROCK_INPUT_PRICE_PER_MILLION=
BEDROCK_OUTPUT_PRICE_PER_MILLION=
PRICE_CURRENCY=USD
# Optional: your own USD to PHP rate for an extra peso column. Left blank, costs stay in USD only.
USD_TO_PHP=
